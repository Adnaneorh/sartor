# =============================================================================
# .env.example — every environment variable this project uses, grouped by the
# phase that introduces it (source of truth: CLAUDE.md "Secrets & API keys").
#
# Copy to .env.local (Next.js app) or worker/.env (worker) and fill in real
# values. NEVER commit real values anywhere. Production values live only in
# the Vercel / Railway dashboards, never in files.
#
# Only NEXT_PUBLIC_-prefixed vars may reach the client; of everything below,
# ONLY the Supabase anon key qualifies. SUPABASE_SERVICE_ROLE_KEY bypasses RLS
# and must never be exposed to client code (CLAUDE.md golden rules 1 & 8).
# =============================================================================


# -----------------------------------------------------------------------------
# Phase 0 — Foundations (local Supabase stack + local LLM + day-one deploy)
# -----------------------------------------------------------------------------

# Where to get: printed by `supabase start` (after `supabase init`, Docker
# Desktop running) as "API URL". Local default shown below. The day-one Vercel
# skeleton uses the SAME three variables with values from the hosted Supabase
# FREE-TIER project (https://supabase.com/dashboard → Settings → API), set in
# the Vercel env dashboard — never in a file.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Where to get: printed by `supabase start` as "anon key". The only variable
# in this file that is allowed to reach the client (RLS is the boundary).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# Where to get: printed by `supabase start` as "service_role key". SERVER/WORKER
# ONLY — bypasses RLS. Never NEXT_PUBLIC, never in client code.
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# LLM provider mode: stub | ollama | hosted (CLAUDE.md "Stack"). stub returns
# fixture results (labeled in UI) and needs no key — default for local dev/tests.
LLM_PROVIDER=stub

# Where to get: no key needed — install Ollama from https://ollama.com, then
# `ollama pull qwen2.5:7b`. Default local endpoint below; used when LLM_PROVIDER=ollama.
OLLAMA_BASE_URL=http://localhost:11434

# Where to get: any model tag you have pulled locally (`ollama list`).
# 7b fits 24 GB machines comfortably; `ollama pull qwen2.5:14b` to upgrade.
OLLAMA_MODEL=qwen2.5:7b


# -----------------------------------------------------------------------------
# Phase 1 — Core loop (app error monitoring)
# -----------------------------------------------------------------------------

# Where to get: https://sentry.io (free tier) → your APP project → Settings →
# Client Keys (DSN). The worker gets its own DSN in Phase 2 (worker/.env).
SENTRY_DSN=your-app-sentry-dsn


# -----------------------------------------------------------------------------
# Phase 2 — Real jobs (Python worker ingestion; these go in worker/.env)
# -----------------------------------------------------------------------------
# NOTE: Greenhouse and Lever board APIs need no key (public, company slugs only).
# NOTE: the worker's SENTRY_DSN (its own Sentry project) also lands here.

# Where to get: free registration at https://developer.adzuna.com → dashboard
# shows Application ID and Application Key. Used with country=ca only.
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# Where to get: free registration at https://services.onetcenter.org/developer/
# ONLY needed if the O*NET↔NOC crosswalk ends up using O*NET Web Services
# (ROADMAP 2.2) — the self-hosted RIASEC test items need no key.
ONET_SERVICES_USERNAME=your-onet-username
ONET_SERVICES_PASSWORD=your-onet-password


# -----------------------------------------------------------------------------
# Phase 3 — Resume pipeline (rate limiting starts here, not Phase 5)
# -----------------------------------------------------------------------------

# Where to get: https://console.upstash.com → your Redis database → REST API
# section. Rate-limits resume upload / tailoring (assistant chat joins Phase 4).
UPSTASH_REDIS_REST_URL=your-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token


# -----------------------------------------------------------------------------
# Phase 5 — Ship (production; set in Vercel/Railway dashboards, NEVER in files)
# -----------------------------------------------------------------------------
# Hosted Supabase: the Phase 0 free-tier project becomes production — verify
# its keys in the Vercel/Railway dashboards and upgrade the tier if needed.
# Sentry DSNs (Phases 1–2) and Upstash (Phase 3) are only VERIFIED here.

# Where to get: https://console.anthropic.com → API Keys. Used when
# LLM_PROVIDER=hosted (production rephrasing quality).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Where to get: https://resend.com or https://postmarkapp.com (free tier) →
# API key. Powers Supabase Auth custom SMTP for production verification emails
# (configured in the Supabase Auth dashboard; the built-in sender is dev-only).
SMTP_PROVIDER_API_KEY=your-smtp-provider-api-key


# -----------------------------------------------------------------------------
# Post-launch — Stripe (not before Phase 5 ships; CLAUDE.md "Payments")
# -----------------------------------------------------------------------------

# Where to get: https://dashboard.stripe.com → Developers → API keys.
# Publishable key is client-safe by design (hence NEXT_PUBLIC); secret key is
# server only. Checkout only — raw card data never touches this codebase.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key

# Where to get: https://dashboard.stripe.com → Developers → Webhooks → your
# endpoint → Signing secret. Every subscription event's signature is verified.
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
